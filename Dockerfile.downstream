# Thin source overlay on the exact deployed upstream release. Runtime and tooling
# come from upstream's Dockerfile; no dependency or base-version upgrade is mixed in.
FROM nousresearch/hermes-agent@sha256:adb7890916de63245523492be8f68f9d2095fecbec4e2a6dab7960381f0fc002
ARG SOURCE_COMMIT
ARG SOURCE_DISTANCE=0
LABEL org.opencontainers.image.source="https://github.com/kate-toc/hermes-agent" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.version="0.23.0-downstream"
USER root
COPY agent/agent_runtime_helpers.py /opt/hermes/agent/agent_runtime_helpers.py
COPY hermes_cli/profiles.py hermes_cli/profiles_initialization.py hermes_cli/profile_provisioning.py hermes_cli/config_defaults.py /opt/hermes/hermes_cli/
RUN /opt/hermes/.venv/bin/python /opt/hermes/scripts/write_install_stamp.py --output /opt/hermes/install-stamp.json \
    --commit "${SOURCE_COMMIT}" --base-version 0.23.0 --distance "${SOURCE_DISTANCE}" \
    --source ci --distribution docker --update-mechanism external
RUN python3 -c 'import json, pathlib; stamp=pathlib.Path("/opt/hermes/install-stamp.json"); s=json.loads(stamp.read_text()); s["pmRuntime"]="/opt/hermes/pm-runtime"; stamp.write_text(json.dumps(s)+"\n"); p=pathlib.Path("/etc/hermes/image-provenance.json"); c=json.loads(p.read_text()); c.update(image="kate-toc/hermes-agent", revision=s["commit"]); p.write_text(json.dumps(c,sort_keys=True)+"\n"); p.chmod(0o444)' \
    && /opt/hermes/.venv/bin/python -c 'from pm.runtime import _resident_runtime; assert _resident_runtime() is not None'
